{
  "name": "bijoudocs",
  "version": "0.5.19",
  "description": "BijouDocs — a desktop script workspace for YouTube scripts",
  "main": "out/main/index.js",
  "author": "Bijou",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "immer": "^11.1.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "com.bijoudocs.app",
    "productName": "BijouDocs",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "build/icon.ico"
    ],
    "publish": {
      "provider": "github",
      "owner": "Bijounga",
      "repo": "bijoudocs",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": [{ "target": "dmg", "arch": "universal" }, { "target": "zip", "arch": "universal" }],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    }
  }
}
